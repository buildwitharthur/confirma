---
import ChatBubble from './ChatBubble.astro';

const command =
	'rounded-md border border-light-green-gray bg-mist px-[7px] py-0.5 font-mono text-xs text-dark-green [box-shadow:var(--rebaixo)]';
---

<div
	role="group"
	aria-label="Exemplo de conversa de confirmação"
	class="overflow-hidden rounded-[20px] border border-transparent [background:linear-gradient(var(--confirma-apoio-branco),var(--confirma-apoio-branco))_padding-box,var(--aresta-clara)_border-box] [box-shadow:var(--elev-3)]"
>
	<div class="flex items-center gap-3 border-b border-light-green-gray px-3 py-3 [background:linear-gradient(180deg,var(--confirma-apoio-branco),var(--confirma-marca-nevoa))] [box-shadow:var(--brilho-topo)] sm:px-4 sm:py-3.5">
		<span
			class="grid size-9 shrink-0 place-items-center rounded-full text-brand [background:linear-gradient(180deg,var(--confirma-apoio-branco),var(--confirma-apoio-verde-claro))] [box-shadow:inset_0_0_0_1px_color-mix(in_srgb,var(--confirma-marca-verde)_18%,var(--confirma-apoio-verde-claro)),var(--elev-1)]"
			aria-hidden="true"
		>
			<svg
				class="size-[18px]"
				viewBox="0 0 16 16"
				fill="none"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linecap="round"
			>
				<rect x="2" y="3" width="12" height="11" rx="2.5"></rect>
				<path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3"></path>
			</svg>
		</span>
		<div class="min-w-0">
			<p class="text-sm leading-[1.3] font-semibold">Confirmação de horário</p>
			<p class="text-xs leading-[1.3] text-dark-green-gray">
				Número conectado da conta
			</p>
		</div>
	</div>

	<div class="flex flex-col gap-3 px-3 py-4 sm:px-4 sm:py-5 md:px-5 md:py-6 [background:radial-gradient(rgb(157_181_172/0.22)_1px,transparent_1.2px)_0_0/18px_18px,var(--confirma-marca-nevoa)] [box-shadow:inset_0_8px_10px_-10px_rgb(11_31_26/0.22),inset_0_-6px_8px_-10px_rgb(11_31_26/0.14)]">
		<ChatBubble variant="in" time="09:00" at="150ms">
			<p>
				Olá,
				<span class="rounded-md bg-light-green px-[3px] py-px font-mono text-[0.85em] font-medium whitespace-nowrap text-dark-green">
					{'{{nome}}'}
				</span>
				! Seu agendamento está marcado para 20/10/2026 às 14:00.
			</p>
			<p class="mt-1.5 text-dark-green-gray">
				Responda 1 para confirmar ou 2 para cancelar.
			</p>
		</ChatBubble>

		<ChatBubble variant="out" time="09:12" at="650ms">
			<p class="text-[1.0625rem] leading-normal font-semibold">
				<span class="sr-only">Resposta do contato: </span>1
			</p>
		</ChatBubble>

		<p
			style="--at: 1000ms; --glow: 1100ms"
			class="flex animate-[whatsapp-step_560ms_cubic-bezier(0.16,1,0.3,1)_var(--at)_backwards] flex-wrap items-center justify-center gap-x-2 gap-y-1.5 self-center rounded-2xl border border-light-green-gray bg-white py-1.5 pr-1.5 pl-3 text-xs text-dark-green-gray motion-reduce:animate-none [box-shadow:var(--brilho-topo),var(--elev-2)]"
		>
			Resposta reconhecida
			<span class="inline-flex animate-[whatsapp-confirm_500ms_cubic-bezier(0.2,0.8,0.2,1)_var(--glow)_backwards] items-center gap-[7px] rounded-full border border-brand bg-light-green px-2.5 py-[5px] text-xs leading-[1.4] font-medium whitespace-nowrap text-dark-green before:size-1.5 before:shrink-0 before:rounded-full before:bg-brand before:content-[''] motion-reduce:animate-none">
				Confirmado
			</span>
		</p>

		<ChatBubble variant="in" time="09:12" at="1250ms">
			<p>
				Tudo certo, sua presença está confirmada. Se precisar cancelar, responda
				2.
			</p>
		</ChatBubble>
	</div>

	<p class="flex flex-wrap items-center gap-2 border-t border-light-green-gray bg-white px-3 py-3 text-xs text-dark-green-gray [box-shadow:var(--brilho-topo)] sm:px-4">
		Respostas reconhecidas: <code class={command}>1</code>
		<code class={command}>2</code> <code class={command}>PARAR</code>
	</p>
</div>
