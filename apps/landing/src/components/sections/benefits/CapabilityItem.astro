---
interface Props {
	title: string;
	description: string;
	iconPath: string;
}

const { title, description, iconPath } = Astro.props;
---

<li class="grid grid-cols-[32px_minmax(0,1fr)] gap-x-4 py-5 not-first:border-t not-first:border-light-green-gray lg:py-6 md:max-lg:grid-cols-1 md:max-lg:content-start md:max-lg:border-t-0 md:max-lg:pt-6 md:max-lg:pb-0">
	<span
		class="row-[1/span_2] grid size-8 shrink-0 place-items-center rounded-[9px] border border-[color-mix(in_srgb,var(--confirma-marca-verde)_22%,var(--confirma-apoio-verde-claro))] bg-light-green text-brand md:max-lg:row-auto md:max-lg:mb-4"
		aria-hidden="true"
	>
		<svg
			class="size-4"
			viewBox="0 0 16 16"
			fill="none"
			stroke="currentColor"
			stroke-width="1.4"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d={iconPath}></path>
		</svg>
	</span>
	<h3 class="mt-1 font-display text-[1.0625rem] leading-[1.3] font-semibold tracking-[-0.005em] text-balance">
		{title}
	</h3>
	<p class="mt-1.5 text-[0.9375rem] leading-[1.55] text-pretty text-dark-green-gray">
		{description}
	</p>
</li>
