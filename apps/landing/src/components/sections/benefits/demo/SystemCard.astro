---
interface Props {
  name: string;
  description: string;
  variant?: 'default' | 'next';
}

const { name, description, variant = 'default' } = Astro.props;
const isNext = variant === 'next';
---

<li
  class:list={[
    'flex min-w-0 items-center gap-3 rounded-xl border px-3 py-2.5 sm:flex-col sm:items-start sm:gap-2.5 sm:p-3',
    isNext
      ? 'border-dashed border-medium-green-gray bg-transparent'
      : 'border-light-green-gray bg-mist',
  ]}
>
  <span
    class="grid size-8 shrink-0 place-items-center rounded-[9px] border border-[color-mix(in_srgb,var(--confirma-marca-verde)_22%,var(--confirma-apoio-verde-claro))] bg-light-green text-brand"
    aria-hidden="true"
  >
    <svg
      class="size-4"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
    >
      {
        isNext ? (
          <path d="M8 3.5v9M3.5 8h9" />
        ) : (
          <>
            <rect x="2" y="3" width="12" height="11" rx="2.5" />
            <path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3" />
          </>
        )
      }
    </svg>
  </span>
  <span>
    <span class="block text-sm leading-[1.3] font-semibold">{name}</span>
    <span class="block text-xs leading-[1.4] text-dark-green-gray">{description}</span>
  </span>
</li>
