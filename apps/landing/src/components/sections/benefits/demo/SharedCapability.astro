---
const surfaceTokens = [
	'[--aresta-escura:linear-gradient(168deg,rgb(255_255_255/0.13),rgb(157_181_172/0.12)_30%,rgb(11_31_26/0.6))]',
	'[--brilho-topo-escuro:inset_0_1px_0_rgb(255_255_255/0.07)]',
];
---

<p
	class:list={[
		'mt-3 flex max-w-none items-center gap-3 rounded-[14px] border border-transparent px-4 py-3.5 text-white sm:mt-0',
		'[background:linear-gradient(180deg,color-mix(in_srgb,var(--confirma-apoio-verde-escuro)_88%,var(--confirma-apoio-verde-profundo)),color-mix(in_srgb,var(--confirma-apoio-verde-escuro)_70%,var(--confirma-marca-noite)))_padding-box,var(--aresta-escura)_border-box]',
		'[box-shadow:var(--brilho-topo-escuro),0_1px_2px_rgb(11_31_26/0.2),1px_10px_20px_-12px_rgb(11_31_26/0.5)]',
		surfaceTokens,
	]}
>
	<span
		class="grid size-8 shrink-0 place-items-center rounded-full border border-[rgb(61_220_151/0.24)] bg-[rgb(61_220_151/0.1)] text-mint"
		aria-hidden="true"
	>
		<svg
			class="size-4"
			viewBox="0 0 16 16"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="m4.5 8.2 2.3 2.3 4.7-4.9"></path>
		</svg>
	</span>
	<span>
		<strong class="block text-[0.9375rem] leading-[1.3] font-semibold tracking-[-0.005em]">
			Confirma
		</strong>
		<small class="block text-[0.8125rem] leading-[1.4] text-light-green-gray">
			A mesma capacidade de confirmação por WhatsApp, compartilhada entre os
			sistemas.
		</small>
	</span>
</p>
