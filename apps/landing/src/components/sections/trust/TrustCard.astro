---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<article class="rounded-2xl border border-light-green-gray bg-transparent p-5 md:p-6">
	<h3 class="font-display text-[1.125rem] leading-[1.3] font-semibold tracking-[-0.005em] text-balance md:text-[1.1875rem]">
		{title}
	</h3>
	<p class="mt-2.5 max-w-[65ch] text-base text-pretty text-dark-green-gray [&_code]:font-mono [&_code]:text-[0.875em] [&_code]:[overflow-wrap:anywhere]">
		<slot />
	</p>
</article>
