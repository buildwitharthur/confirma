---
import DevelopersContent from './DevelopersContent.astro';
import CodeShowcase from './demo/CodeShowcase.astro';
---

<section
  id="integracao"
  aria-labelledby="developer-title"
  class="scroll-mt-22 border-b border-deep-green bg-night py-16 text-white md:py-24 min-[1200px]:py-30"
>
  <div
    class="mx-auto grid w-full max-w-[1280px] items-center gap-10 px-5 md:gap-12 md:px-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 min-[1200px]:px-12"
  >
    <DevelopersContent />
    <CodeShowcase />
  </div>
</section>
