---
import StatusBadge from '../StatusBadge.astro';

const history = [
  { label: 'Agendado', sequence: 'sequence 1' },
  { label: 'Enviado', sequence: 'sequence 2' },
  { label: 'Confirmado · resposta 1', sequence: 'sequence 3' },
];
---

<aside
  aria-label="Detalhe conceitual do agendamento agenda-8472"
  style="--at: 760ms"
  class="animate-[dashboard-step_560ms_cubic-bezier(0.16,1,0.3,1)_var(--at)_backwards] rounded-2xl border border-transparent p-4 motion-reduce:animate-none [background:linear-gradient(180deg,var(--confirma-apoio-branco)_60%,color-mix(in_srgb,var(--confirma-apoio-branco)_60%,var(--confirma-marca-nevoa)))_padding-box,var(--aresta-clara)_border-box] [box-shadow:var(--brilho-topo),var(--elev-3)]"
>
  <div class="flex items-center justify-between gap-3 border-b border-light-green-gray pb-3">
    <div>
      <p class="text-xs text-dark-green-gray">Detalhe</p>
      <span class="block font-mono text-sm font-medium text-night">agenda-8472</span>
    </div>
    <StatusBadge state="confirmed" raised />
  </div>

  <ol
    aria-label="Histórico de estados"
    class="relative mt-3.5 grid gap-3 before:absolute before:top-1.5 before:bottom-1.5 before:left-[5px] before:w-px before:bg-light-green-gray before:content-['']"
  >
    {
      history.map(({ label, sequence }) => (
        <li class="relative flex items-baseline justify-between gap-3 pl-[22px] text-[0.8125rem] before:absolute before:top-[5px] before:left-0 before:size-[11px] before:rounded-full before:border-[1.5px] before:border-medium-green-gray before:bg-white before:content-[''] last:font-semibold last:before:border-brand last:before:bg-brand last:before:[box-shadow:0_0_0_3px_var(--confirma-apoio-verde-claro)]">
          {label}
          <code class="font-mono text-[0.6875rem] font-normal whitespace-nowrap text-dark-green-gray">
            {sequence}
          </code>
        </li>
      ))
    }
  </ol>

  <p
    class="mt-3.5 border-t border-light-green-gray pt-3 font-mono text-[0.6875rem] leading-normal font-medium text-dark-green-gray [overflow-wrap:anywhere]"
  >
    Evento <b class="font-medium text-brand">appointment.confirmed</b> → receptor do cliente
  </p>
</aside>
