---
const ctaSurface =
  '[background:linear-gradient(180deg,color-mix(in_srgb,var(--confirma-marca-verde)_90%,var(--confirma-marca-menta)),var(--confirma-marca-verde)_42%,var(--confirma-marca-verde)_62%,color-mix(in_srgb,var(--confirma-marca-verde)_84%,var(--confirma-marca-noite)))_padding-box,linear-gradient(168deg,color-mix(in_srgb,var(--confirma-marca-menta)_60%,var(--confirma-marca-verde)),var(--confirma-marca-verde)_46%,color-mix(in_srgb,var(--confirma-marca-verde)_55%,var(--confirma-marca-noite)))_border-box]';

const ctaPressed =
  'active:[background:linear-gradient(180deg,color-mix(in_srgb,var(--confirma-marca-verde)_84%,var(--confirma-marca-noite)),var(--confirma-marca-verde)_38%,var(--confirma-marca-verde))_padding-box,linear-gradient(168deg,color-mix(in_srgb,var(--confirma-marca-verde)_55%,var(--confirma-marca-noite)),var(--confirma-marca-verde)_60%,color-mix(in_srgb,var(--confirma-marca-menta)_35%,var(--confirma-marca-verde)))_border-box]';
---

<div>
  <p
    class="mb-5 flex items-center gap-2.5 text-xs leading-[1.2] font-semibold tracking-[0.09em] text-mint uppercase lg:mb-6"
  >
    Agendou, confirmou.
  </p>

  <h1
    id="hero-title"
    class="max-w-[16ch] font-display text-[clamp(2.125rem,1.2rem+4.6vw,3.25rem)] leading-[1.08] font-semibold tracking-[-0.015em] text-balance md:max-w-[18ch] lg:max-w-[21ch] lg:text-[clamp(3.5rem,1.4rem+3.4vw,4.5rem)] lg:leading-[1.04] lg:tracking-[-0.018em]"
  >
    Confirmações por WhatsApp, <span class="text-mint">integradas ao seu sistema.</span>
  </h1>

  <p
    class="mt-6 max-w-[52ch] text-[1.0625rem] leading-[1.6] text-pretty text-light-green-gray md:text-[1.1875rem] lg:mt-7 lg:max-w-[54ch]"
  >
    Envie o agendamento pela API e receba por webhook a resposta do contato. A agenda continua no
    sistema que você já opera.
  </p>

  <div
    class="mt-7 flex flex-col items-stretch gap-x-5 gap-y-3 sm:flex-row sm:flex-wrap sm:items-center md:mt-8"
  >
    <button
      type="button"
      data-assistant-open
      class:list={[
        'inline-flex min-h-[52px] w-full items-center justify-center gap-2.5 rounded-[10px] border border-transparent px-5 py-[15px] text-[0.9375rem] leading-[1.2] font-semibold text-white [text-shadow:0_1px_0_rgb(11_31_26/0.16)] sm:w-auto lg:min-h-12 lg:py-[13px]',
        'transition-[translate,color,box-shadow] duration-[220ms] ease-[cubic-bezier(0.2,0.8,0.2,1)] hover:-translate-y-px hover:duration-200 active:translate-y-px active:duration-[140ms] motion-reduce:hover:translate-y-0 motion-reduce:active:translate-y-0',
        '[box-shadow:inset_0_1px_0_rgb(255_255_255/0.2),inset_0_-1px_0_rgb(11_31_26/0.16),0_0_0_1px_rgb(61_220_151/0.1),0_2px_2px_rgb(4_12_10/0.5),1px_6px_14px_-6px_rgb(4_12_10/0.9)]',
        'hover:[box-shadow:inset_0_1px_0_rgb(255_255_255/0.3),inset_0_-1px_0_rgb(11_31_26/0.18),0_0_0_1px_rgb(61_220_151/0.16),0_2px_3px_rgb(4_12_10/0.5),1px_10px_22px_-8px_rgb(4_12_10/0.95)]',
        'active:[box-shadow:inset_0_2px_4px_rgb(11_31_26/0.3),inset_0_1px_0_rgb(11_31_26/0.2),0_1px_0_rgb(255_255_255/0.08)]',
        ctaSurface,
        ctaPressed,
      ]}
    >
      Solicitar acesso ao piloto
      <span class="inline-block text-[1.1em] leading-none font-normal" aria-hidden="true">↗</span>
    </button>
  </div>
</div>
