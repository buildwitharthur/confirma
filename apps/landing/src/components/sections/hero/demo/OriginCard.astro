---
const step =
	'animate-[hero-step_560ms_cubic-bezier(0.16,1,0.3,1)_0ms_backwards] motion-reduce:animate-none';
---

<article
	aria-label="Sistema de origem"
	class:list={[
		'relative rounded-2xl border border-transparent p-4 text-night lg:p-[18px]',
		'[background:linear-gradient(180deg,var(--confirma-marca-nevoa),color-mix(in_srgb,var(--confirma-marca-nevoa)_82%,var(--confirma-apoio-cinza-verde-claro)))_padding-box,var(--aresta-clara)_border-box]',
		'[box-shadow:var(--brilho-topo),var(--base-escura),0_1px_2px_var(--noite-funda),2px_16px_32px_-16px_var(--noite-funda)]',
		step,
	]}
>
	<header class="mb-3.5 flex items-center gap-2.5">
		<span
			class="grid size-8 shrink-0 place-items-center rounded-[9px] border border-[color-mix(in_srgb,var(--confirma-marca-verde)_22%,var(--confirma-apoio-verde-claro))] bg-light-green text-brand [box-shadow:var(--brilho-topo)]"
			aria-hidden="true"
		>
			<svg
				class="size-4"
				viewBox="0 0 16 16"
				fill="none"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linecap="round"
			>
				<rect x="2" y="3" width="12" height="11" rx="2.5"></rect>
				<path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3"></path>
			</svg>
		</span>
		<span>
			<span class="block text-xs leading-[1.3] font-semibold text-night">
				Sistema de origem
			</span>
			<span class="block font-mono text-[0.6875rem] leading-[1.4] font-medium text-dark-green-gray [overflow-wrap:anywhere]">
				POST /v1/appointments
			</span>
		</span>
	</header>

	<p class="mb-2.5 text-[0.9375rem] font-medium text-dark-green">
		Agendamento enviado à API
	</p>

	<dl class="grid gap-1.5 border-t border-light-green-gray pt-3 font-mono text-[0.6875rem] leading-[1.4] [box-shadow:inset_0_1px_0_var(--confirma-apoio-branco)]">
		<div class="flex justify-between gap-3">
			<dt class="text-dark-green-gray">external_id</dt>
			<dd class="text-right text-night">agenda-8472</dd>
		</div>
		<div class="flex justify-between gap-3">
			<dt class="text-dark-green-gray">scheduled_at</dt>
			<dd class="text-right text-night">20/10 · 14:00</dd>
		</div>
	</dl>

	<div class="mt-3.5 flex items-center justify-between gap-2 text-xs text-dark-green-gray">
		<span>Estado</span>
		<span class="inline-flex items-center gap-[7px] rounded-full border border-medium-green-gray bg-white px-2.5 py-[5px] text-xs leading-[1.4] font-medium whitespace-nowrap text-dark-green-gray [box-shadow:var(--elev-1)] before:size-1.5 before:shrink-0 before:rounded-full before:bg-current before:content-['']">
			Agendado
		</span>
	</div>
</article>
