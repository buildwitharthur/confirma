---
const animation =
	'animate-[hero-step_560ms_cubic-bezier(0.16,1,0.3,1)_var(--at)_backwards,hero-glow_600ms_cubic-bezier(0.2,0.8,0.2,1)_var(--glow)_backwards] motion-reduce:animate-none';
const alternativeEvent =
	'rounded-md border border-deep-green px-1.5 py-0.5 font-mono text-[0.6875rem] whitespace-nowrap text-light-green-gray';
---

<article
	aria-label="Retorno ao sistema de origem"
	style="--at: 1400ms; --glow: 1700ms"
	class:list={[
		'relative rounded-2xl border border-transparent p-4 text-white lg:p-[18px]',
		'[background:linear-gradient(180deg,color-mix(in_srgb,var(--confirma-apoio-verde-escuro)_88%,var(--confirma-apoio-verde-profundo)),color-mix(in_srgb,var(--confirma-apoio-verde-escuro)_70%,var(--confirma-marca-noite)))_padding-box,linear-gradient(168deg,rgb(61_220_151/0.6),rgb(61_220_151/0.4)_50%,rgb(61_220_151/0.28))_border-box]',
		'[box-shadow:var(--brilho-topo-escuro),0_0_0_4px_rgb(61_220_151/0.07),2px_18px_36px_-16px_var(--noite-funda)]',
		animation,
	]}
>
	<header class="mb-3.5 flex items-center gap-2.5">
		<span
			class="grid size-8 shrink-0 place-items-center rounded-[9px] border border-[rgb(61_220_151/0.2)] bg-[rgb(61_220_151/0.1)] text-mint"
			aria-hidden="true"
		>
			<svg
				class="size-4"
				viewBox="0 0 16 16"
				fill="none"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M13.5 8.5V12a1.5 1.5 0 0 1-1.5 1.5H4A1.5 1.5 0 0 1 2.5 12V4A1.5 1.5 0 0 1 4 2.5h3.5"></path>
				<path d="M10 2.5h3.5V6M13.5 2.5 8 8"></path>
			</svg>
		</span>
		<span>
			<span class="block text-xs leading-[1.3] font-semibold text-white">
				Retorno ao seu sistema
			</span>
			<span class="block font-mono text-[0.6875rem] leading-[1.4] font-medium text-medium-green-gray [overflow-wrap:anywhere]">
				POST → seu receptor
			</span>
		</span>
	</header>

	<code class="mb-2.5 block font-mono text-[0.8125rem] leading-[1.4] font-medium text-mint [overflow-wrap:anywhere]">
		appointment.confirmed
	</code>

	<dl class="-mx-1 grid gap-1.5 rounded-[10px] bg-[rgb(11_31_26/0.55)] p-2.5 font-mono text-[0.6875rem] leading-[1.4] [box-shadow:inset_0_2px_6px_-1px_rgb(4_12_10/0.55),inset_0_0_0_1px_rgb(4_12_10/0.35),0_1px_0_rgb(255_255_255/0.05)]">
		<div class="flex justify-between gap-3">
			<dt class="text-medium-green-gray">external_id</dt>
			<dd class="text-right text-mist">agenda-8472</dd>
		</div>
		<div class="flex justify-between gap-3">
			<dt class="text-medium-green-gray">status</dt>
			<dd class="text-right text-mist">confirmed</dd>
		</div>
		<div class="flex justify-between gap-3">
			<dt class="text-medium-green-gray">sequence</dt>
			<dd class="text-right text-mist">3</dd>
		</div>
	</dl>

	<p class="mt-3.5 flex flex-wrap items-center gap-1.5 text-xs leading-[1.4] text-medium-green-gray">
		Também possíveis:
		<code class={alternativeEvent}>canceled</code>
		<code class={alternativeEvent}>no_response</code>
		<code class={alternativeEvent}>failed</code>
	</p>
</article>
