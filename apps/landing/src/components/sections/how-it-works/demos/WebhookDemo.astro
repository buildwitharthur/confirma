---
import DemoFrame from './DemoFrame.astro';
import FlowHead from './FlowHead.astro';

const fields = [
	['external_id', 'agenda-8472'],
	['status', 'confirmed'],
	['sequence', '3'],
] as const;

const alternativeEvents = [
	'appointment.canceled',
	'appointment.no_response',
	'appointment.failed',
] as const;

const check =
	"relative pl-[22px] before:absolute before:top-[0.45em] before:left-0.5 before:h-[5px] before:w-2.5 before:-rotate-45 before:border-b-[1.5px] before:border-l-[1.5px] before:border-brand before:content-['']";
const codeChip =
	'rounded-md border border-light-green-gray bg-mist px-[5px] font-mono text-[0.8125rem] text-dark-green [box-shadow:var(--rebaixo)] [overflow-wrap:anywhere]';
---

<DemoFrame
	captionId="how-caption-webhook"
	caption="Trecho ilustrativo do evento, não o payload completo."
>
	<article
		aria-label="Evento de resultado enviado por webhook"
		class="relative min-w-0 rounded-2xl border border-transparent p-4 text-white sm:w-[86%] sm:pb-10 [background:linear-gradient(180deg,color-mix(in_srgb,var(--confirma-apoio-verde-escuro)_88%,var(--confirma-apoio-verde-profundo)),color-mix(in_srgb,var(--confirma-apoio-verde-escuro)_70%,var(--confirma-marca-noite)))_padding-box,linear-gradient(var(--luz-angulo),rgb(61_220_151/0.6),rgb(61_220_151/0.28))_border-box] [box-shadow:var(--brilho-topo-escuro),0_0_0_4px_rgb(61_220_151/0.08),2px_16px_32px_-14px_rgb(11_31_26/0.5)]"
	>
		<FlowHead
			tone="dark"
			kicker="Webhook do Confirma"
			route="POST → seu receptor"
		>
			<path d="M13.5 8.5V12a1.5 1.5 0 0 1-1.5 1.5H4A1.5 1.5 0 0 1 2.5 12V4A1.5 1.5 0 0 1 4 2.5h3.5"></path>
			<path d="M10 2.5h3.5V6M13.5 2.5 8 8"></path>
		</FlowHead>
		<code class="mb-2.5 block font-mono text-[0.8125rem] leading-[1.4] font-medium text-mint [overflow-wrap:anywhere]">
			appointment.confirmed
		</code>
		<dl class="grid gap-1.5 rounded-[10px] bg-[rgb(11_31_26/0.55)] p-2.5 font-mono text-xs leading-[1.4] [box-shadow:var(--rebaixo-escuro)]">
			{fields.map(([name, value]) => (
				<div class="flex flex-wrap justify-between gap-x-3">
					<dt class="text-medium-green-gray">{name}</dt>
					<dd class="ml-auto min-w-0 text-right text-mist [overflow-wrap:anywhere]">
						{value}
					</dd>
				</div>
			))}
		</dl>
		<p class="mt-3.5 flex flex-wrap items-center gap-1.5 text-xs leading-[1.4] text-medium-green-gray">
			Também possíveis:
			{alternativeEvents.map((event) => (
				<code class="rounded-md border border-deep-green px-1.5 py-0.5 font-mono text-[0.6875rem] whitespace-nowrap text-light-green-gray">
					{event}
				</code>
			))}
		</p>
	</article>

	<article
		aria-label="Seu sistema como receptor do evento"
		class="relative z-10 min-w-0 rounded-2xl border border-transparent p-4 text-night transition-transform duration-[420ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-data-[active=false]/panel:translate-y-2 sm:-mt-7 sm:ml-auto sm:w-[62%] [background:linear-gradient(180deg,var(--confirma-apoio-branco),color-mix(in_srgb,var(--confirma-marca-nevoa)_70%,var(--confirma-apoio-branco)))_padding-box,var(--aresta-clara)_border-box] [box-shadow:var(--brilho-topo),var(--base-escura),var(--elev-2)]"
	>
		<FlowHead tone="light" kicker="Seu sistema" route="Receptor de webhook">
			<rect x="2" y="3" width="12" height="11" rx="2.5"></rect>
			<path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3"></path>
		</FlowHead>
		<ul class="grid gap-2 border-t border-light-green-gray pt-3 text-sm leading-[1.45]">
			<li class={check}>
				Valida <code class={codeChip}>Confirma-Signature</code>
			</li>
			<li class={check}>
				Registra o evento e responde <code class={codeChip}>2xx</code>
			</li>
			<li class={check}>Aplica o resultado à própria agenda</li>
		</ul>
	</article>
</DemoFrame>
