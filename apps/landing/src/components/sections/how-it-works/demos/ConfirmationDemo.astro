---
import DemoFrame from './DemoFrame.astro';

const chip =
  'rounded-md border border-light-green-gray bg-mist px-[7px] py-0.5 font-mono text-xs text-dark-green [box-shadow:var(--rebaixo)]';
---

<DemoFrame
  captionId="how-caption-confirmation"
  caption="Exemplo ilustrativo de uma solicitação e de uma resposta reconhecida."
>
  <div
    role="group"
    aria-label="Exemplo de solicitação de confirmação"
    class="overflow-hidden rounded-[20px] border border-transparent [background:linear-gradient(var(--confirma-apoio-branco),var(--confirma-apoio-branco))_padding-box,var(--aresta-clara)_border-box] [box-shadow:var(--elev-2)]"
  >
    <div
      class="flex items-center gap-3 border-b border-light-green-gray px-4 py-3.5 [background:linear-gradient(180deg,var(--confirma-apoio-branco),var(--confirma-marca-nevoa))] [box-shadow:var(--brilho-topo)]"
    >
      <span
        class="grid size-9 shrink-0 place-items-center rounded-full text-brand [background:linear-gradient(180deg,var(--confirma-apoio-branco),var(--confirma-apoio-verde-claro))] [box-shadow:inset_0_0_0_1px_color-mix(in_srgb,var(--confirma-marca-verde)_18%,var(--confirma-apoio-verde-claro)),var(--elev-1)]"
        aria-hidden="true"
      >
        <svg
          class="size-[18px]"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        >
          <rect x="2" y="3" width="12" height="11" rx="2.5"></rect>
          <path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3"></path>
        </svg>
      </span>
      <div class="min-w-0">
        <p class="text-sm leading-[1.3] font-semibold">Solicitação de confirmação</p>
        <p class="text-xs leading-[1.3] text-dark-green-gray">Número conectado da conta</p>
      </div>
    </div>

    <div
      class="flex flex-col gap-3 px-4 py-5 [background:radial-gradient(rgb(157_181_172/0.22)_1px,transparent_1.2px)_0_0/18px_18px,var(--confirma-marca-nevoa)] [box-shadow:inset_0_8px_10px_-10px_rgb(11_31_26/0.22),inset_0_-6px_8px_-10px_rgb(11_31_26/0.14)]"
    >
      <div
        class="max-w-[86%] self-start rounded-[14px] rounded-tl-[4px] border border-transparent px-3 pt-2.5 pb-2 text-[0.9375rem] leading-normal [background:linear-gradient(var(--confirma-apoio-branco),var(--confirma-apoio-branco))_padding-box,var(--aresta-clara)_border-box] [box-shadow:var(--brilho-topo),var(--elev-1)]"
      >
        <p>
          Olá,
          <span
            class="rounded-md bg-light-green px-[3px] py-px font-mono text-[0.85em] font-medium whitespace-nowrap text-dark-green"
            >{'{{nome}}'}</span
          >! Seu agendamento está marcado para 20/10/2026 às 14:00.
        </p>
        <p class="mt-1.5 text-dark-green-gray">Responda 1 para confirmar ou 2 para cancelar.</p>
      </div>

      <div
        class="max-w-[86%] min-w-[72px] self-end rounded-[14px] rounded-tr-[4px] px-3 pt-2.5 pb-2 text-right text-white [background:linear-gradient(180deg,color-mix(in_srgb,var(--confirma-marca-verde)_90%,var(--confirma-marca-menta)),var(--confirma-marca-verde)_45%,color-mix(in_srgb,var(--confirma-marca-verde)_86%,var(--confirma-marca-noite)))] [box-shadow:inset_0_1px_0_rgb(255_255_255/0.22),inset_0_-1px_0_rgb(11_31_26/0.16),var(--elev-2)]"
      >
        <p class="text-[1.0625rem] leading-normal font-semibold">
          <span class="sr-only">Resposta do contato: </span>1
        </p>
      </div>

      <p
        class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1.5 self-center rounded-2xl border border-light-green-gray bg-white py-1.5 pr-1.5 pl-3 text-xs text-dark-green-gray [box-shadow:var(--brilho-topo),var(--elev-2)]"
      >
        Resposta reconhecida
        <span
          class="inline-flex items-center gap-[7px] rounded-full border border-brand bg-light-green px-2.5 py-[5px] text-xs leading-[1.4] font-medium whitespace-nowrap text-dark-green before:size-1.5 before:shrink-0 before:rounded-full before:bg-brand before:content-['']"
        >
          Confirmado
        </span>
      </p>
    </div>

    <p
      class="flex flex-wrap items-center gap-x-2 gap-y-1.5 border-t border-light-green-gray bg-white px-4 py-3 text-xs text-dark-green-gray [box-shadow:var(--brilho-topo)]"
    >
      <code class={chip}>1</code> confirmar
      <code class={chip}>2</code> cancelar
      <code class={chip}>PARAR</code> interromper mensagens
    </p>
  </div>
</DemoFrame>
