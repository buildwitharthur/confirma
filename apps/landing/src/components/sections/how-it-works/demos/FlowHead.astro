---
interface Props {
	tone: 'light' | 'dark';
	kicker: string;
	route: string;
}

const { tone, kicker, route } = Astro.props;
const isDark = tone === 'dark';
---

<header class="mb-3.5 flex items-center gap-2.5">
	<span
		class:list={[
			'grid size-8 shrink-0 place-items-center rounded-[9px] border',
			isDark
				? 'border-[rgb(61_220_151/0.2)] bg-[rgb(61_220_151/0.1)] text-mint'
				: 'border-[color-mix(in_srgb,var(--confirma-marca-verde)_22%,var(--confirma-apoio-verde-claro))] bg-light-green text-brand',
		]}
		aria-hidden="true"
	>
		<svg
			class="size-4"
			viewBox="0 0 16 16"
			fill="none"
			stroke="currentColor"
			stroke-width="1.4"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<slot />
		</svg>
	</span>
	<span class="min-w-0">
		<span
			class:list={[
				'block text-xs leading-[1.3] font-semibold',
				isDark ? 'text-white' : 'text-night',
			]}
		>
			{kicker}
		</span>
		<span
			class:list={[
				'block font-mono text-[0.6875rem] leading-[1.4] font-medium [overflow-wrap:anywhere]',
				isDark ? 'text-medium-green-gray' : 'text-dark-green-gray',
			]}
		>
			{route}
		</span>
	</span>
</header>
