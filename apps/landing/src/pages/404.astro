---
import Base from '../layouts/Base.astro';
import { utilityNavigation } from '../components/layout/header/navigation';

const [documentation] = utilityNavigation;
---

<Base
	title="Página não encontrada | Confirma"
	description="O endereço que você abriu não existe ou mudou de lugar."
	indexable={false}
>
	<div class="flex min-h-dvh flex-col bg-night font-sans text-white">
		<header class="border-b border-deep-green">
			<div class="mx-auto flex h-16 max-w-[1280px] items-center px-5 md:px-8 lg:h-[72px] min-[1200px]:px-12">
				<a
					class="inline-flex min-h-11 items-center"
					href="/"
					aria-label="Confirma — início"
				>
					<img
						src="/confirma-logo-branco.svg"
						width="145"
						height="56"
						alt="Confirma"
					/>
				</a>
			</div>
		</header>

		<main
			id="conteudo"
			class="mx-auto flex w-full max-w-[1280px] flex-1 flex-col justify-center px-5 py-16 md:px-8 min-[1200px]:px-12"
		>
			<p class="font-display text-[clamp(6rem,3rem+14vw,12rem)] leading-none font-semibold tracking-[-0.03em] text-mint">
				404
			</p>

			<h1 class="mt-6 font-display text-[clamp(2rem,1.3rem+3vw,3rem)] leading-[1.06] font-semibold tracking-[-0.015em] text-balance">
				Página não encontrada
			</h1>

			<p class="mt-5 max-w-[46ch] text-[1.0625rem] leading-[1.6] text-pretty text-light-green-gray">
				O endereço que você abriu não existe ou mudou de lugar.
			</p>

			<nav
				aria-label="Para onde ir"
				class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap"
			>
				<a
					href="/"
					class="inline-flex min-h-[52px] items-center justify-center rounded-[10px] border border-transparent px-5 py-3 text-[0.9375rem] leading-[1.2] font-semibold text-white transition-[translate] duration-[220ms] ease-[cubic-bezier(0.2,0.8,0.2,1)] [background:linear-gradient(180deg,color-mix(in_srgb,var(--confirma-marca-verde)_90%,var(--confirma-marca-menta)),var(--confirma-marca-verde)_42%,color-mix(in_srgb,var(--confirma-marca-verde)_84%,var(--confirma-marca-noite)))_padding-box,linear-gradient(168deg,color-mix(in_srgb,var(--confirma-marca-menta)_60%,var(--confirma-marca-verde)),var(--confirma-marca-verde)_46%,color-mix(in_srgb,var(--confirma-marca-verde)_55%,var(--confirma-marca-noite)))_border-box] [box-shadow:inset_0_1px_0_rgb(255_255_255/0.2),inset_0_-1px_0_rgb(11_31_26/0.16),0_2px_2px_rgb(4_12_10/0.5),1px_6px_14px_-6px_rgb(4_12_10/0.9)] hover:-translate-y-px active:translate-y-px motion-reduce:hover:translate-y-0 motion-reduce:active:translate-y-0"
				>
					Voltar ao início
				</a>
				<a
					href={documentation.href}
					class="inline-flex min-h-[52px] items-center justify-center rounded-[10px] border border-muted-green/60 bg-gradient-to-b from-dark-green to-night px-5 py-3 text-[0.9375rem] leading-[1.2] font-semibold text-white shadow-[inset_0_1px_0_rgb(255_255_255_/_0.08),0_1px_2px_rgb(4_12_10_/_0.6)] transition-[translate,border-color] duration-[220ms] ease-[cubic-bezier(0.2,0.8,0.2,1)] hover:-translate-y-px hover:border-mint/60 active:translate-y-px motion-reduce:hover:translate-y-0 motion-reduce:active:translate-y-0"
				>
					Ver a documentação
				</a>
			</nav>
		</main>
	</div>
</Base>
