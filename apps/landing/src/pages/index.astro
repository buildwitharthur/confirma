---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/header/Header.astro';
import Footer from '../components/layout/footer/Footer.astro';
import HeroSection from '../components/sections/hero/HeroSection.astro';
import BenefitsSection from '../components/sections/benefits/BenefitsSection.astro';
import HowItWorksSection from '../components/sections/how-it-works/HowItWorksSection.astro';

import WhatsAppSection from '../components/sections/whatsapp/WhatsAppSection.astro';
import DashboardSection from '../components/sections/dashboard/DashboardSection.astro';
import DevelopersSection from '../components/sections/developers/DevelopersSection.astro';
import TrustSection from '../components/sections/trust/TrustSection.astro';

const title = 'Confirma | Confirmações por WhatsApp via API';

const description =
	'O Confirma ajuda software houses e desenvolvedores a integrar confirmações de agendamentos via WhatsApp ao sistema existente e receber o resultado por webhook.';

const canonicalUrl = new URL('/', Astro.site);

const ogImageUrl = new URL('/og.png', Astro.site);

const ogImageAlt =
	'Confirma: confirmações por WhatsApp, integradas ao seu sistema.';

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${canonicalUrl}#organization`,
			name: 'Confirma',
			url: canonicalUrl.toString(),
			logo: new URL('/confirma-logo.png', Astro.site).toString(),
		},
		{
			'@type': 'WebSite',
			'@id': `${canonicalUrl}#website`,
			name: 'Confirma',
			url: canonicalUrl.toString(),
			inLanguage: 'pt-BR',
			publisher: { '@id': `${canonicalUrl}#organization` },
		},
		{
			'@type': 'SoftwareApplication',
			name: 'Confirma',
			url: canonicalUrl.toString(),
			description,
			applicationCategory: 'BusinessApplication',
			operatingSystem: 'Web',
			inLanguage: 'pt-BR',
			publisher: { '@id': `${canonicalUrl}#organization` },
		},
	],
};
---

<Base title={title} description={description}>
	<Fragment slot="head">
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Confirma" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		></script>
	</Fragment>

	<Header />
	<main id="conteudo" class="font-sans text-night">
		<HeroSection />
		<BenefitsSection />
		<HowItWorksSection />
		<WhatsAppSection />
		<DashboardSection />
		<DevelopersSection />
		<TrustSection />
	</main>
	<Footer />
</Base>
