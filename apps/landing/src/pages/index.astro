---
import '../styles/global.css';
import Header from '../components/layout/header/Header.astro';
import HeroSection from '../components/sections/hero/HeroSection.astro';
import BenefitsSection from '../components/sections/benefits/BenefitsSection.astro';

const title = 'Confirma | Confirmações por WhatsApp via API';

const description =
  'O Confirma ajuda software houses e desenvolvedores a integrar confirmações de agendamentos via WhatsApp ao sistema existente e receber o resultado por webhook.';

const canonicalUrl = new URL('/', Astro.site);

const isIndexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Confirma',
  url: canonicalUrl.toString(),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={isIndexable ? 'index, follow' : 'noindex, follow'} />
    <meta name="theme-color" content="#0B1F1A" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Confirma" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..700&family=Geist+Mono:wght@400..600&family=Manrope:wght@400..600&display=swap"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  </head>
  <body>
    <Header />
    <main id="conteudo" class="font-sans text-night">
      <HeroSection />
      <BenefitsSection />
    </main>
  </body>
</html>
