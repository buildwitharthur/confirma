{
  "name": "api",
  "version": "0.0.0",
  "description": "",
  "main": "dist/common/infrastructure/http/server.js",
  "scripts": {
    "dev": "tsx --watch src/common/infrastructure/http/server.ts",
    "build": "tsc",
    "start": "node dist/common/infrastructure/http/server.js",
    "prisma:migrate:deploy": "prisma migrate deploy --config src/common/infrastructure/prisma/prisma.config.ts",
    "prisma:generate": "prisma generate --config src/common/infrastructure/prisma/prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config src/common/infrastructure/prisma/prisma.config.ts",
    "test:run": "pnpm env:load:test pnpm vitest run",
    "test": "pnpm env:load:test pnpm prisma:migrate:deploy && pnpm test:run",
    "env:load:test": "dotenv run --override -f .env.test --",
    "pre:test": "docker run --name confirma-postgres-test -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=confirma_test -p 5433:5432 -d postgres:18-alpine",
    "post:test": "docker stop confirma-postgres-test && docker rm confirma-postgres-test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "resend": "^6.34.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
}
